# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
backend/venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Environment files
.env
.env.*
!.env.example

# Local docker-compose overrides (host port remaps for dev — user-specific).
docker-compose.override.yml

# TypeScript incremental build info — regenerated on every build.
frontend/tsconfig.tsbuildinfo

# Local Claude workspace copies. Canonical brand docs live in /docs.
.claude/docs/

# Node / frontend
node_modules/
dist/
build/
.npmrc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cloudflare Worker build artifacts.
# worker/public is a copy of frontend/dist made at deploy time; python_modules
# and .wrangler are generated by `uv run pywrangler deploy`. ~88MB combined.
worker/public/
worker/python_modules/
worker/.wrangler/
worker/.venv-workers/

# gstack tool workspace
.gstack/

# One-shot Postgres→D1 data dump (~1MB of INSERTs). The schema IS tracked;
# the seed is regenerable via backend/scripts/export_to_d1.py and would go
# stale the moment the sync runs.
backend/d1/seed.sql

# Editors/IDE
.idea/
# Keep VS Code settings tracked for project conventions
# .vscode/  # DO NOT ignore; we track settings.json

# Logs
logs
*.log

# Misc
*.swp
*.swo

