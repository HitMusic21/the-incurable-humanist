# VCS
.git
.gitignore

# macOS
.DS_Store

# Python
__pycache__
*.pyc
*.pyo
*.pyd
backend/venv

# Node
node_modules
frontend/node_modules
frontend/dist

# Env — `.env` alone only matches the top-level; use `**/.env` to catch nested
# files like `backend/.env` that pydantic-settings otherwise picks up inside
# the container. This stopped a real leak of Railway prod DATABASE_URL +
# FRONTEND_URL in Sprint 1.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Editor
.vscode
.idea
